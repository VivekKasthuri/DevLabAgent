<Window x:Class="DevLab.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DevLab.Views"
        Title="DevLab" Height="800" Width="1400"
        MinHeight="600" MinWidth="960"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>   <!-- Title bar -->
      <RowDefinition Height="*"/>    <!-- Main content -->
    </Grid.RowDefinitions>

    <!-- ── Title bar ────────────────────────────────────────────────────── -->
    <Grid Grid.Row="0" Background="{StaticResource Bg2Brush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush2}"
              BorderThickness="0,0,1,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
          <TextBlock Text="⬡" FontSize="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
          <TextBlock Text="DevLab" FontSize="14" FontWeight="SemiBold"
                     Foreground="{StaticResource AccentBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- Breadcrumb -->
      <TextBlock Grid.Column="1" x:Name="BreadcrumbText"
                 Text="No file open" FontSize="12" FontFamily="Cascadia Code, Consolas"
                 Foreground="{DynamicResource TextDimBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

      <!-- Toolbar right -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
        <Button Content="📂 Open" Style="{StaticResource IconButton}"
                Click="OnOpenFolder" ToolTip="Open project folder (Ctrl+O)" Margin="0,0,6,0"/>

        <Border Background="{StaticResource Bg3Brush}" CornerRadius="4" Margin="0,0,10,0" Padding="8,3">
          <TextBlock Text="DevLab Coder" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
        </Border>

        <!-- Status dot -->
        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource YellowBrush}"
                 VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                   VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush2}"
            BorderThickness="0,0,0,1" IsHitTestVisible="False"/>

    <!-- ── Main layout ───────────────────────────────────────────────────── -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" MinWidth="140" MaxWidth="400"/>
        <ColumnDefinition Width="3"/>   <!-- Splitter -->
        <ColumnDefinition Width="*"/>   <!-- Editor -->
        <ColumnDefinition Width="3"/>   <!-- Splitter -->
        <ColumnDefinition Width="340" MinWidth="260" MaxWidth="520"/>
      </Grid.ColumnDefinitions>

      <!-- File tree -->
      <views:FileTreePanel Grid.Column="0" x:Name="FileTreePanel"/>

      <GridSplitter Grid.Column="1" Width="3" Background="{StaticResource BorderBrush2}"
                    HorizontalAlignment="Stretch" Cursor="SizeWE"/>

      <!-- Editor + terminal -->
      <views:EditorPanel Grid.Column="2" x:Name="EditorPanel"/>

      <GridSplitter Grid.Column="3" Width="3" Background="{StaticResource BorderBrush2}"
                    HorizontalAlignment="Stretch" Cursor="SizeWE"/>

      <!-- Chat -->
      <views:ChatPanel Grid.Column="4" x:Name="ChatPanel"/>
    </Grid>
  </Grid>
</Window>
