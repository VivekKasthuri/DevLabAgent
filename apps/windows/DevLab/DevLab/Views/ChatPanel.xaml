<UserControl x:Class="DevLab.Views.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DevLab.Views"
             Background="{StaticResource Bg2Brush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="36"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1"
            Background="{StaticResource Bg2Brush}">
      <Grid Margin="12,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="🧠" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock Text="AI CHAT" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="✦ New" Style="{StaticResource IconButton}"
                  Click="OnNewSession" ToolTip="New session" Margin="0,0,4,0"/>
          <Button Content="🗑" Style="{StaticResource IconButton}"
                  Click="OnClearContext" ToolTip="Clear context"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Messages -->
    <ScrollViewer Grid.Row="1" x:Name="MessagesScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource BgBrush}">
      <ItemsControl x:Name="MessagesList" Margin="10">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <views:MessageBubbleView Margin="0,0,0,10"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Input -->
    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0"
            Background="{StaticResource Bg2Brush}" Padding="10">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="InputBox" Grid.Column="0"
                   Style="{StaticResource ChatInput}"
                   MaxHeight="140" MinHeight="38"
                   KeyDown="OnInputKeyDown"
                   ToolTip="Type a prompt or use voice input"/>
          <Button Grid.Column="1" Content="🎤" Style="{StaticResource SendButton}"
                  Margin="8,0,0,0" Click="OnVoiceInput" x:Name="VoiceBtn"
                  VerticalAlignment="Bottom" Width="34" Height="34" FontSize="13"/>
          <Button Grid.Column="2" Content="➤" Style="{StaticResource SendButton}"
                  Margin="8,0,0,0" Click="OnSend" x:Name="SendBtn"
                  VerticalAlignment="Bottom" Width="34" Height="34" FontSize="14"/>
        </Grid>
        <Grid Margin="0,6,0,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="ConnDot" Width="6" Height="6" Fill="{StaticResource YellowBrush}"
                     VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBlock x:Name="StatusLabel" Text="Starting…" FontSize="11"
                       Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="ThinkingLabel" Text="Thinking…" FontSize="11"
                     Foreground="{StaticResource AccentBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Center"
                     Visibility="Collapsed"/>
        </Grid>
      </StackPanel>
    </Border>

    <Border x:Name="ChatBusyBorder"
            Grid.RowSpan="3"
            Grid.ZIndex="20"
            Margin="4"
            CornerRadius="8"
            BorderThickness="1.2"
            BorderBrush="{StaticResource AccentBrush}"
            Opacity="0.0"
            Visibility="Collapsed"
            IsHitTestVisible="False"/>
  </Grid>
</UserControl>
