# ── Model Provider ────────────────────────────────────────────────────────────
# Default provider: groq | claude | ollama | free | copilot
# MODEL_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here

# Optional: override default model
# GROQ_MODEL=llama-3.3-70b-versatile

# Claude / Anthropic
# CLAUDE_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-3-5-sonnet-latest

# ── Server-Hosted Model (Ollama on your server) ───────────────────────────────
# Run Ollama on this machine, DevLab acts as OpenAI-compatible proxy:
#   1. Install Ollama:  curl -fsSL https://ollama.com/install.sh | sh
#   2. Pull a model:    ollama pull llama3.2        (or qwen2.5-coder, deepseek-r1, etc.)
#   3. Set below and start DevLab:  devlab serve --model-server
#
# MODEL_PROVIDER=ollama
# OPENAI_COMPAT_BASE_URL=http://localhost:11434   # Ollama on same server
# OPENAI_COMPAT_MODEL=llama3.2                   # must match pulled model name
# OPENAI_COMPAT_API_KEY=                         # leave blank for Ollama
#
# To expose Ollama directly (without DevLab proxy), set in /etc/systemd/system/ollama.service:
#   Environment="OLLAMA_HOST=0.0.0.0"

# ── DevLab Server Auth (for remote/team access) ───────────────────────────────
# Protect the server when exposed over network:
# DEVLAB_API_KEY=your-secret-key-here
# DEVLAB_HOST=0.0.0.0    # bind to all interfaces (default for serve command)

# Copilot alias fallback provider
# COPILOT_FALLBACK_PROVIDER=groq

# Optional: memory DB path (default: ~/.devlab/memory.db)
# MEMORY_DB_PATH=/path/to/memory.db
# Optional: MCP servers config file (default: ~/.devlab/mcp-servers.json)
# MCP_SERVERS_CONFIG=/absolute/path/to/mcp-servers.json
# MCP_REQUEST_TIMEOUT_MS=20000

# Optional: safety level (strict | normal | autonomous)
# Strict = always confirm shell/git commands
# Normal = confirm destructive ops
# Autonomous = no confirmations (use carefully!)
SAFETY_MODE=normal

# ── Privacy (for hosted/server mode) ─────────────────────────────────────────
# Set on your server to ensure client source code is NEVER stored or logged.
# Prompts are processed in-memory only — nothing written to DB on server side.
# DEVLAB_NO_LOG=1

# Atlassian (Jira + Confluence)
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=your_api_token
# CONFLUENCE_BASE_URL=https://your-domain.atlassian.net
# CONFLUENCE_EMAIL=you@example.com
# CONFLUENCE_API_TOKEN=your_api_token

# Figma API (for reading shared Figma file URLs)
# FIGMA_API_TOKEN=your_figma_api_token

# GitHub PR bot (list/review PRs, post scorecard comments)
# Fine-grained PAT with Pull requests: read/write — https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_your_token
